#!/bin/sh
# See tool/README.md. objective_c's build hook only ever asks
# `xcrun --show-sdk-path --sdk macosx`, and takes the first line of stdout. The
# broken Xcode's xcrun writes nothing to stdout and the hook throws
# `Bad state: No element`. The Command Line Tools SDK is installed and is a
# valid answer, so answer it directly.
#
# Everything else falls through to the real xcrun and fails as it would anyway:
# this shim is not trying to be a working Xcode.
case "$*" in
  *--show-sdk-path*)
    echo /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk
    exit 0
    ;;
esac
exec /usr/bin/xcrun "$@"
